# Public website origin used for canonical, Open Graph, sitemap, and robots URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional GA4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Optional Resend email delivery. Leave all three empty to log enquiries server-side.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
